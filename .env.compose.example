# Spark Libre — Docker Compose dev environment.
# Copy to .env. .env is gitignored; .env.compose.example is the template.
# THIS IS FOR LOCAL TESTING ONLY. Production keeps secrets in OS keyring.

# --- OBS WebSocket --------------------------------------------------------
# Same value you set in OBS → Tools → WebSocket Server Settings.
SPARK_OBS_PASSWORD=test-test

# Where the backend reaches OBS:
#   127.0.0.1:4455  → OBS in this same compose stack (default)
#   <other host>    → some other reachable OBS (override only if you know why)
SPARK_OBS_HOST=127.0.0.1
SPARK_OBS_PORT=4455

# Set to 1 to skip OBS entirely (pure backend smoke test, no overlay inject).
SPARK_MOCK_OBS=0

# --- LLM ------------------------------------------------------------------
# Fill the key matching SPARK_DEFAULT_MODEL. Others can stay empty.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
# NVIDIA NIM — free credits at https://build.nvidia.com/. Click any model,
# then "Get API Key" to generate one. Format: nvapi-...
NVIDIA_NIM_API_KEY=
# DeepSeek (platform.deepseek.com) — cheap pay-as-you-go (no free tier).
DEEPSEEK_API_KEY=
# OpenRouter (openrouter.ai) — aggregator with a free models tier.
# Use models tagged "(free)" in their catalog. Format: sk-or-...
OPENROUTER_API_KEY=

# Examples:
#   anthropic/claude-sonnet-4-6
#   openai/gpt-4o-mini
#   gemini/gemini-2.0-flash
#   groq/llama-3.3-70b-versatile
#   nvidia_nim/meta/llama-3.3-70b-instruct
#   nvidia_nim/qwen/qwen2.5-coder-32b-instruct
#   deepseek/deepseek-chat
#   deepseek/deepseek-coder
#   openrouter/meta-llama/llama-3.3-70b-instruct:free
#   openrouter/qwen/qwen-2.5-coder-32b-instruct:free
#   ollama/llama3.1
SPARK_DEFAULT_MODEL=anthropic/claude-sonnet-4-6

# Custom endpoint for self-hosted providers (Ollama, vLLM, LM Studio).
# Leave empty for provider defaults.
SPARK_LLM_BASE_URL=

# DEBUG | INFO | WARNING | ERROR
SPARK_LOG_LEVEL=INFO
