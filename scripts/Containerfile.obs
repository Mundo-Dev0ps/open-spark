# OBS Studio in a container, with full features (CEF / browser panels).
#
# Why Ubuntu + the obsproject PPA?
#   The official Fedora obs-studio package ships WITHOUT CEF (Chromium
#   Embedded Framework) due to licensing, which means no Browser Source
#   and no Custom Browser Docks — both core features Open Spark depends
#   on. The obsproject PPA on Ubuntu is maintained by upstream and ships
#   full CEF.
#
# All persistent state lives in /portable (bind-mounted from the host).
# obs-websocket is built into OBS Studio 28+; no extra plugin needed.

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        software-properties-common \
        gnupg \
        ca-certificates \
        wget \
    && add-apt-repository -y ppa:obsproject/obs-studio \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        obs-studio \
        # GPU / video stack
        libgl1 libegl1 libglx-mesa0 libgles2 \
        mesa-vulkan-drivers \
        mesa-va-drivers \
        libva2 va-driver-all \
        # Audio
        pipewire pipewire-pulse pulseaudio-utils \
        libasound2t64 libasound2-plugins \
        # Webcams
        v4l-utils \
        # Wayland / X11 / desktop integration
        libwayland-client0 libwayland-cursor0 libwayland-egl1 \
        libxkbcommon0 libxkbcommon-x11-0 \
        libqt6waylandclient6 libqt6svg6 \
        # Qt6 WebEngine runtime (required by obs-open-spark plugin
        # so its embedded QWebEngineView can render the backend UI).
        libqt6webenginewidgets6 libqt6webenginecore6 \
        libnss3 libxcomposite1 libxdamage1 libxrandr2 libxtst6 \
        libcups2t64 libxss1 libasound2t64 \
        xdg-desktop-portal \
        dbus-user-session \
        # Locale + utilities
        locales \
        procps iproute2 \
    && locale-gen en_US.UTF-8 C.UTF-8 \
    && apt-get purge -y software-properties-common gnupg wget \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

# Non-root user matching host UID/GID 1000 (default first user on most
# Linux distros). Override at build time:
#   docker compose build --build-arg UID=$(id -u) --build-arg GID=$(id -g) obs
# Without a real /etc/passwd entry, OBS sees HOME="" and writes config to
# "//.config/obs-studio" which is unwritable. Baking the user fixes that.
ARG UID=1000
ARG GID=1000
# Ubuntu 24.04 base ships a default `ubuntu` user at UID 1000. We remove
# it (and any group at GID 1000) before creating the obs user, so the
# UID/GID we want is free.
RUN set -eux; \
    if id -u "${UID}" >/dev/null 2>&1; then \
        userdel -f "$(id -un ${UID})" 2>/dev/null || true; \
    fi; \
    if getent group "${GID}" >/dev/null 2>&1; then \
        groupdel "$(getent group ${GID} | cut -d: -f1)" 2>/dev/null || true; \
    fi; \
    groupadd -g "${GID}" obs; \
    useradd -u "${UID}" -g "${GID}" -d /portable -s /bin/bash -M obs; \
    mkdir -p /portable "/run/user/${UID}"; \
    chown "${UID}:${GID}" /portable "/run/user/${UID}"; \
    chmod 700 "/run/user/${UID}"

# Qt + Wayland + locale. C.UTF-8 silences the "non-UTF-8 locale" warning
# Qt prints on minimal images.
ENV QT_X11_NO_MITSHM=1 \
    QT_QPA_PLATFORM=xcb \
    GDK_BACKEND=x11,wayland \
    XDG_SESSION_TYPE=x11 \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    HOME=/portable \
    XDG_CONFIG_HOME=/portable/config \
    XDG_CACHE_HOME=/portable/cache \
    XDG_DATA_HOME=/portable/data \
    XDG_STATE_HOME=/portable/state

# Bind-mount target for portable OBS data.
WORKDIR /portable
VOLUME ["/portable"]

USER obs

# obs --portable looks for ./config and ./scenes next to its CWD.
# We pass --portable via CMD so the user can override args at run time.
ENTRYPOINT ["obs"]
CMD ["--portable", "--multi", "--minimize-to-tray=false"]
